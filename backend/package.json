{
  "name": "ad-scd-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend foundation for the AD preclinical SCD screening project",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "start": "node --import tsx src/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:validate": "tsx scripts/validate-schema.ts",
    "auth:hash": "tsx scripts/hash-password.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^3.18.3",
    "pg": "^8.23.0"
  }
}
