.login-page { min-height: 100vh; padding: 180rpx 32rpx 60rpx; box-sizing: border-box; background: linear-gradient(180deg, #dff4ff 0, #f5f8fc 45%); }
.hero { text-align: center; margin-bottom: 56rpx; }
.brain { width: 180rpx; height: 180rpx; line-height: 180rpx; margin: 0 auto 32rpx; border-radius: 50%; background: linear-gradient(135deg, #51c8e5, #75e0c5); color: #fff; font-size: 48rpx; font-weight: 700; }
.hero-title { color: #07164f; font-size: 54rpx; font-weight: 700; }
.hero-subtitle { margin-top: 16rpx; color: #657080; font-size: 28rpx; }
.login-card { padding: 40rpx 32rpx 32rpx; }
.input-row { display: flex; align-items: center; height: 104rpx; margin-bottom: 24rpx; padding: 0 28rpx; border: 2rpx solid #e1e5eb; border-radius: 56rpx; box-sizing: border-box; }
.input-icon { display: flex; align-items: center; justify-content: center; width: 52rpx; color: #1769e0; font-size: 38rpx; }
.user-icon { font-size: 42rpx; }
.lock-icon { font-size: 36rpx; }
.input-row input { flex: 1; font-size: 32rpx; }
.agreement { padding-top: 28rpx; text-align: center; font-size: 24rpx; }
