<view class="page safe-bottom"><view class="page-title">测评记录</view><view wx:if="{{records.length === 0}}" class="empty card muted">暂无测评记录</view><view wx:for="{{records}}" wx:key="assessmentId" class="record card" bindtap="open" data-id="{{item.assessmentId}}"><view class="record-main"><view class="record-title">{{item.scaleCode}}</view><view class="muted">{{item.status}} · {{item.createdAt}}</view></view><view class="record-score">{{item.scoreSummary.totalScore === null ? '待评分' : item.scoreSummary.totalScore}}</view></view></view>
