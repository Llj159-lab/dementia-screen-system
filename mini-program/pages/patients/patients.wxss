.topbar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  margin-bottom: 32rpx;
  padding-top: 24rpx;
}

.topbar .page-title {
  color: #07164f;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.25;
}

.back-button,
.add-button {
  position: absolute;
  top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  box-sizing: border-box;
}

.back-button {
  left: 0;
  color: #454b56;
  font-size: 74rpx;
  font-weight: 300;
  line-height: 66rpx;
}

.add-button {
  right: 0;
  padding: 0;
  border-radius: 50%;
  background: #1769e0;
  color: #fff;
  font-size: 58rpx;
  font-weight: 300;
  line-height: 72rpx;
}

.search {
  display: flex;
  align-items: center;
  height: 96rpx;
  margin-bottom: 28rpx;
  padding: 0 28rpx;
}

.search-icon {
  color: #27374d;
  font-size: 48rpx;
  line-height: 1;
}

.search input {
  flex: 1;
  margin-left: 20rpx;
  color: #253044;
  font-size: 30rpx;
}

.patient-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 188rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: #e3f1ff;
  color: #1769e0;
  font-size: 42rpx;
  font-weight: 700;
}

.patient-main {
  flex: 1;
  min-width: 0;
}

.patient-name {
  overflow: hidden;
  color: #07164f;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.patient-code,
.patient-meta {
  margin-top: 10rpx;
  color: #5f6672;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 1.4;
}

.patient-meta {
  display: flex;
  gap: 30rpx;
  margin-top: 6rpx;
}

.delete-button {
  position: absolute;
  top: 18rpx;
  right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  color: #8c949e;
  font-size: 28rpx;
  line-height: 1;
}

.arrow {
  margin-left: 16rpx;
  color: #9aa2ac;
  font-size: 52rpx;
  font-weight: 300;
}

.empty {
  margin-top: 80rpx;
  padding: 56rpx 24rpx;
  text-align: center;
}
