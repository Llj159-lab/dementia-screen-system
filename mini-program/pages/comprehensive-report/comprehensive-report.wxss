.report-page { min-height: 100vh; padding: 0 32rpx 48rpx; background: #f5f8fc; }.report-header { position: relative; display: flex; align-items: center; justify-content: center; height: 120rpx; }.page-title { color: #07164f; font-size: 48rpx; font-weight: 700; }.back-button { position: absolute; left: 0; color: #454b56; font-size: 74rpx; line-height: 1; }.card { border-radius: 30rpx; background: #fff; box-shadow: 0 12rpx 36rpx rgba(19,55,105,.08); }.patient-card { display: flex; align-items: center; margin-bottom: 28rpx; padding: 24rpx; }.avatar { display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; margin-right: 20rpx; border-radius: 50%; background: #e3f1ff; color: #1769e0; font-size: 36rpx; font-weight: 700; }.patient-name { color: #07164f; font-size: 34rpx; font-weight: 700; }.patient-meta,.result-time { margin-top: 8rpx; color: #737b87; font-size: 24rpx; }.overview-card,.radar-card,.advice-card { margin-bottom: 28rpx; padding: 32rpx 26rpx; }.section-title { margin-bottom: 20rpx; color: #07164f; font-size: 34rpx; font-weight: 700; }.result-row { display: flex; align-items: center; padding: 20rpx 0; border-top: 2rpx solid #eef0f3; }.result-code { color: #18244d; font-size: 29rpx; font-weight: 700; }.result-score { margin-left: auto; color: #1769e0; font-size: 30rpx; font-weight: 700; }.result-label { min-width: 100rpx; margin-left: 16rpx; color: #20aa63; font-size: 23rpx; text-align: right; }.result-label.abnormal { color: #e45a28; }.radar { display: block; width: 100%; height: 430rpx; }.radar-note,.advice { color: #596273; font-size: 28rpx; line-height: 1.7; text-align: center; }.primary-button { margin-top: 8rpx; }
