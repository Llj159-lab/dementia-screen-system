.sync-header { position: relative; display: flex; align-items: center; justify-content: center; height: 96rpx; margin-bottom: 10rpx; }
.page-title { color: #07164f; font-size: 46rpx; font-weight: 700; }
.back-button { position: absolute; left: 0; color: #454b56; font-size: 68rpx; line-height: 1; }
.hero { margin-bottom: 20rpx; padding: 16rpx 0 10rpx; text-align: center; }
.hero-icon { display: flex; align-items: center; justify-content: center; width: 180rpx; height: 180rpx; margin: 0 auto 16rpx; border-radius: 50%; background: #e6f3ff; color: #1769e0; font-size: 72rpx; }
.hero-title { color: #20aa63; font-size: 40rpx; font-weight: 700; }
.hero .muted { margin-top: 12rpx; color: #7a818c; font-size: 24rpx; }
.stats { display: flex; justify-content: space-between; margin-bottom: 20rpx; padding: 28rpx 16rpx; text-align: center; }
.stats view { flex: 1; display: flex; flex-direction: column; gap: 10rpx; color: #6f7683; font-size: 24rpx; }
.stats .value { color: #07164f; font-size: 38rpx; font-weight: 700; }
.block { margin-bottom: 20rpx; padding: 24rpx 20rpx; }
.block-title { color: #07164f; font-size: 30rpx; font-weight: 700; }
.row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.row button { flex: 1; margin: 0; border-radius: 999rpx; font-size: 26rpx; line-height: 78rpx; }
.row .danger { border: 2rpx solid #e14b4b; background: #fff; color: #e14b4b; }
.row .ghost { border: 2rpx solid #1769e0; background: #fff; color: #1769e0; }
.primary-button { margin-top: 10rpx; }
