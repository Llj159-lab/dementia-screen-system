<view class="page safe-bottom"><view class="assessment-head"><view class="muted">第 {{currentIndex + 1}} / {{items.length}} 题</view><view class="progress"><view style="width: {{progress}}%"></view></view><view class="scale-title">{{scale.name}}</view></view><view wx:if="{{currentItem}}" class="card question-card"><view class="question-number">第{{currentIndex + 1}}题</view><view class="question-text">{{currentItem.text}}</view><view class="options"><view wx:for="{{currentItem.options}}" wx:key="code" class="option {{answers[currentItem.code] === item.code ? 'selected' : ''}}" bindtap="selectOption" data-code="{{item.code}}"><view class="radio">{{answers[currentItem.code] === item.code ? '✓' : ''}}</view><text>{{item.text}}</text></view></view></view><view class="bottom-actions"><button class="secondary-button" bindtap="previous" disabled="{{currentIndex === 0}}">上一题</button><button class="primary-button" bindtap="next">{{currentIndex === items.length - 1 ? '提交测评' : '下一题'}}</button></view></view>
