.assessment-head { padding: 24rpx 0 28rpx; }.progress { height: 12rpx; margin: 18rpx 0; border-radius: 10rpx; background: #dfe5ee; overflow: hidden; }.progress view { height: 100%; border-radius: inherit; background: #1769e0; }.scale-title { color: #07164f; font-size: 34rpx; font-weight: 700; }.question-card { min-height: 760rpx; padding: 36rpx 28rpx; }.question-number { color: #1769e0; font-size: 30rpx; font-weight: 700; }.question-text { margin: 36rpx 0 48rpx; color: #07164f; font-size: 42rpx; font-weight: 700; line-height: 1.5; }.option { display: flex; align-items: center; min-height: 96rpx; margin-bottom: 20rpx; padding: 0 24rpx; border-radius: 22rpx; background: #f0f5fb; color: #101d47; font-size: 32rpx; }.option.selected { background: #dcecff; color: #1769e0; }.radio { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; margin-right: 20rpx; border: 3rpx solid #7b94b6; border-radius: 50%; color: #fff; }.selected .radio { border-color: #1769e0; background: #1769e0; }.bottom-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }.bottom-actions button { flex: 1; }.bottom-actions .primary-button { margin: 0; }
