<view class="page safe-bottom"><view class="picker-header"><view class="back-button" bindtap="back">‹</view><text class="page-title">选择患者</text></view><view class="search card"><text>⌕</text><input placeholder="搜索患者姓名或编号" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="load" /></view><view wx:if="{{patients.length === 0}}" class="empty card muted">暂无患者，请先建立患者档案</view><view wx:for="{{patients}}" wx:key="patientId" class="patient-card card" bindtap="select" data-id="{{item.patientId}}"><view class="avatar">{{item.initial}}</view><view class="patient-main"><view class="patient-name">{{item.name}}</view><view class="patient-code">编号：{{item.patientCode}}</view><view class="patient-meta">性别：{{item.genderLabel}}　年龄：{{item.ageLabel}}</view></view><text class="check">{{item.selected ? '✓' : '›'}}</text></view></view>
