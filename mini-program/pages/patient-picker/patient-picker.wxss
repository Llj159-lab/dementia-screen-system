.picker-header { position: relative; display: flex; align-items: center; justify-content: center; height: 96rpx; margin-bottom: 28rpx; }.page-title { color: #07164f; font-size: 48rpx; font-weight: 700; }.back-button { position: absolute; left: 0; color: #454b56; font-size: 74rpx; line-height: 1; }.search { display: flex; align-items: center; height: 96rpx; margin-bottom: 24rpx; padding: 0 28rpx; color: #1769e0; font-size: 46rpx; }.search input { flex: 1; margin-left: 18rpx; font-size: 30rpx; }.patient-card { position: relative; display: flex; align-items: center; min-height: 188rpx; margin-bottom: 22rpx; padding: 28rpx; }.avatar { display: flex; align-items: center; justify-content: center; width: 100rpx; height: 100rpx; margin-right: 24rpx; border-radius: 50%; background: #e3f1ff; color: #1769e0; font-size: 40rpx; font-weight: 700; }.patient-main { flex: 1; }.patient-name { color: #07164f; font-size: 36rpx; font-weight: 700; }.patient-code, .patient-meta { margin-top: 8rpx; color: #68717e; font-size: 26rpx; }.check { color: #1769e0; font-size: 44rpx; }.empty { margin-top: 80rpx; padding: 56rpx 20rpx; text-align: center; }
