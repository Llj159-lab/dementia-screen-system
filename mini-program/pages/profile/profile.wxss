.profile-hero { display: flex; align-items: center; margin: -32rpx -32rpx 28rpx; padding: 96rpx 44rpx 56rpx; background: linear-gradient(135deg, #1976ed, #3aa8f3); color: #fff; border-radius: 0 0 48rpx 48rpx; }.profile-avatar { display: flex; align-items: center; justify-content: center; width: 132rpx; height: 132rpx; margin-right: 28rpx; border: 6rpx solid #fff; border-radius: 50%; background: #e4f4ff; color: #1769e0; font-size: 56rpx; font-weight: 700; }.profile-name { font-size: 44rpx; font-weight: 700; }.profile-hero .muted { margin-top: 12rpx; color: #eaf6ff; }.menu { padding: 12rpx 32rpx; }.menu-item { display: flex; justify-content: space-between; padding: 30rpx 0; border-bottom: 2rpx solid #edf0f4; color: #17234e; font-size: 32rpx; }.menu-item text:last-child { color: #9aa2ac; font-size: 44rpx; }.logout { margin: 28rpx 0 16rpx; background: transparent; color: #d23c3c; font-size: 32rpx; }
