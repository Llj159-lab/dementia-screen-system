.result-page { min-height: 100vh; padding: 0 32rpx 48rpx; background: #f5f8fc; }.result-header { position: relative; display: flex; align-items: center; justify-content: center; height: 120rpx; }.page-title { color: #07164f; font-size: 48rpx; font-weight: 700; }.back-button { position: absolute; left: 0; color: #454b56; font-size: 74rpx; line-height: 1; }.patient-strip { display: flex; align-items: center; margin-bottom: 28rpx; padding: 22rpx 26rpx; }.avatar { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; margin-right: 18rpx; border-radius: 50%; background: #e3f1ff; color: #1769e0; font-size: 32rpx; font-weight: 700; }.patient-name { flex: 1; color: #07164f; font-size: 32rpx; font-weight: 700; }.patient-strip .muted { font-size: 22rpx; }.score-hero { padding: 38rpx 34rpx; border-radius: 32rpx; background: linear-gradient(135deg, #2678ee, #65a6ff); color: #fff; }.hero-code { font-size: 42rpx; font-weight: 700; }.hero-score { margin: 16rpx 0; font-size: 72rpx; font-weight: 700; }.hero-score text { margin-left: 10rpx; font-size: 32rpx; }.result-label { display: inline-block; padding: 12rpx 24rpx; border-radius: 999rpx; background: #fff; color: #1769e0; font-size: 26rpx; }.result-label.abnormal { color: #e45a28; }.detail-card, .advice-card { margin-top: 28rpx; padding: 30rpx 26rpx; }.section-title { margin-bottom: 20rpx; color: #07164f; font-size: 34rpx; font-weight: 700; }.detail-row { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 2rpx solid #eef0f3; color: #667080; font-size: 27rpx; }.detail-row text:last-child { color: #18244d; }.advice-card .muted { font-size: 27rpx; line-height: 1.7; }.primary-button { margin-top: 28rpx; margin-bottom: 18rpx; }.secondary-button { margin-top: 0; }
