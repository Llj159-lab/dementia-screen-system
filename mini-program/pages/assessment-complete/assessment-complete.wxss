.complete-page { min-height: 100vh; padding: 70rpx 32rpx 48rpx; box-sizing: border-box; background: #f5f8fc; text-align: center; }.complete-illustration { display: flex; align-items: center; justify-content: center; width: 180rpx; height: 180rpx; margin: 0 auto 28rpx; border-radius: 50%; background: linear-gradient(135deg, #75d5df, #6de0b4); color: #fff; font-size: 110rpx; font-weight: 700; }.subtitle { margin-top: 16rpx; color: #5f6877; font-size: 28rpx; }.overview { margin-top: 48rpx; padding: 32rpx 18rpx; }.overview-grid { display: flex; margin-top: 28rpx; }.overview-grid > view { display: flex; flex: 1; flex-direction: column; gap: 12rpx; border-right: 2rpx solid #edf0f3; color: #68717e; font-size: 24rpx; }.overview-grid > view:last-child { border-right: 0; }.overview-value { color: #07164f; font-size: 36rpx; font-weight: 700; }.notice { margin: 28rpx 0; color: #8a6500; font-size: 27rpx; }.primary-button { margin-bottom: 18rpx; }
