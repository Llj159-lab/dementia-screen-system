<view class="guide-page safe-bottom"><view class="guide-header"><view class="back-button" bindtap="back">‹</view><text class="page-title">量表指导</text></view><view class="guide-hero"><view class="guide-mark">{{scale.scaleCode}}</view><view class="guide-title">{{scale.name}}</view><view class="muted">开始前请阅读以下测评说明</view></view><view class="card guide-card"><view class="guide-section"><view class="section-title">适用人群</view><view class="guide-text">{{guide.audience}}</view><view class="guide-text">{{guide.diseases}}</view></view><view class="guide-section"><view class="section-title">测评内容</view><view class="guide-text">{{guide.content}}</view></view><view class="guide-section"><view class="section-title">操作指导</view><view class="guide-text">{{guide.operation}}</view></view><view class="guide-section"><view class="section-title">注意事项</view><view class="notice">{{guide.notice}}</view></view><view class="guide-section"><view class="section-title">评分标准</view><view class="guide-text">{{scale.instructions[0]}}</view><view class="score-rule">满分：{{scale.scoring.scoreMax}} 分　题目：{{scale.items.length}} 题</view><view wx:for="{{scale.scoring.cutoffs}}" wx:key="group_key" class="cutoff"><text>{{item.group_key}}</text><text>{{item.result_label}}</text><text>{{item.threshold !== null ? '界值：' + item.threshold : ''}}</text></view></view></view><button class="primary-button" bindtap="start">开始测评</button></view>
