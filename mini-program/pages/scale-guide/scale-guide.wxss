.guide-page { min-height: 100vh; padding: 0 32rpx 48rpx; background: #f5f8fc; }.guide-header { position: relative; display: flex; align-items: center; justify-content: center; height: 120rpx; }.page-title { color: #07164f; font-size: 48rpx; font-weight: 700; }.back-button { position: absolute; left: 0; color: #454b56; font-size: 74rpx; line-height: 1; }.guide-hero { padding: 36rpx 0; text-align: center; }.guide-mark { display: flex; align-items: center; justify-content: center; width: 240rpx; height: 160rpx; margin: 0 auto 24rpx; border-radius: 36rpx; background: linear-gradient(135deg, #2d8ff5, #64d6cb); color: #fff; font-size: 48rpx; font-weight: 700; }.guide-title { color: #07164f; font-size: 40rpx; font-weight: 700; line-height: 1.4; }.guide-hero .muted { margin-top: 14rpx; font-size: 26rpx; }.guide-card { padding: 34rpx 28rpx; }.guide-section { padding-bottom: 30rpx; }.section-title { position: relative; padding-left: 22rpx; color: #07164f; font-size: 34rpx; font-weight: 700; }.section-title::before { position: absolute; top: 6rpx; bottom: 6rpx; left: 0; width: 8rpx; border-radius: 8rpx; background: #1769e0; content: ''; }.guide-text { margin-top: 16rpx; color: #4f5868; font-size: 28rpx; line-height: 1.7; }.notice { margin-top: 16rpx; padding: 20rpx; border-radius: 16rpx; background: #fff2a9; color: #6d5700; font-size: 27rpx; line-height: 1.6; }.score-rule { margin-top: 18rpx; padding: 18rpx; border-radius: 14rpx; background: #eef6ff; color: #1769e0; font-size: 27rpx; }.cutoff { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 2rpx solid #eef0f3; color: #586170; font-size: 24rpx; }.cutoff text:nth-child(2) { color: #18244d; }.primary-button { margin-top: 28rpx; }
