.tab-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 10; display: flex; height: 116rpx; padding-bottom: env(safe-area-inset-bottom); border-top: 2rpx solid #edf0f4; background: #fff; box-shadow: 0 -8rpx 24rpx rgba(19, 55, 105, 0.06); }.tab-item { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; color: #626a78; }.tab-item.selected { color: #1769e0; }.tab-icon { height: 44rpx; font-size: 34rpx; line-height: 44rpx; }.tab-label { margin-top: 4rpx; font-size: 30rpx; font-weight: 600; line-height: 40rpx; }
